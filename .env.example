# Generate secrets with: ./scripts/gen_secrets.sh > .env  (then edit the rest)
POSTGRES_PASSWORD=change-me
VMS_SECRET_KEY=change-me-64-hex
VMS_FERNET_KEY=change-me-fernet-key
VMS_INTERNAL_TOKEN=change-me-64-hex
VMS_MEDIA_KEY=change-me-base64-32-bytes

# Network exposure: bind ONLY to a private interface. Never 0.0.0.0 on an internet-facing host.
VMS_BIND_IP=127.0.0.1
VMS_SITE_ADDRESS=https://vms.lan:8443
VMS_WEBRTC_HOSTS=192.168.10.5          # LAN IP (and Tailscale 100.x IP) of this server
VMS_COOKIE_SECURE=true
VMS_TZ=Asia/Kolkata

# AI worker (CPU)
VMS_MODEL_PATH=/models/detector.onnx
VMS_AI_FPS=2
VMS_ORT_THREADS=4
VMS_DET_CONF=0.45
VMS_WORKER_CPUS=8

# Cloud enrichment (face / ANPR / re-ID on event crops only; outbound HTTPS from site)
VMS_ENRICH_URL=
VMS_ENRICH_TOKEN=

# Alerts
VMS_TWILIO_SID=
VMS_TWILIO_TOKEN=
VMS_TWILIO_FROM=
VMS_WA_TOKEN=
VMS_WA_PHONE_ID=
VMS_WA_TEMPLATE=security_alert
VMS_WA_LANG=en
VMS_ALARM_WEBHOOK_URL=
VMS_ALARM_SECONDS=30

VMS_EVENT_RETENTION_DAYS=30
CF_TUNNEL_TOKEN=

# Security-alert email (export / unblur notifications to admins + super admins)
VMS_SMTP_HOST=
VMS_SMTP_PORT=587
VMS_SMTP_USER=
VMS_SMTP_PASSWORD=
VMS_SMTP_FROM=
VMS_RECORDING_RETENTION_HOURS=720
